diff --git a/apps/desktop/.env.linux.example b/apps/desktop/.env.linux.example
new file mode 100644
index 0000000..11c54f4
--- /dev/null
+++ b/apps/desktop/.env.linux.example
@@ -0,0 +1,9 @@
+# Copy to .env.linux (Git ignored). Use UTF-8 and quote values containing # or spaces.
+# Values are not shell-expanded.
+# Linux AppImage builds publish no update feed and poll no mandatory-update policy, so they
+# take no deployment origin, signing identity, or notarization credentials.
+DSH_DESKTOP_APP_ID=com.deepseek.harness
+
+# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
+# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
+# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
\ No newline at end of file
